      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "grasp_sg": {
      "skill": "grasping-with-planner",
      "inputs": {
        "target_obb": "OrientedBoundingBox",
        "target_mask": "Mask"
      },
      "outputs": {
        "ee_pose_at_grasp": {
          "$ref": "observe.arms.0.ee_pose"
        },
        "grasp_pose": {
          "$ref": "compute_grasp.candidates.poses.0"
        }
      },
      "nodes": {
        "open": {
          "type": "tool",
          "inputs": {
            "settle_steps": 40
          },
          "tool": "robot.open_gripper"
        },
        "compute_grasp": {
          "type": "tool",
          "inputs": {
            "obb": {
              "$ref": "in.target_obb"
            }
          },
          "tool": "geometry.top_down_grasp_candidates"
        },
        "approach": {
          "type": "script",
          "inputs": {
            "target_position": {
              "$ref": "compute_grasp.candidates.poses.0.position"
            },
            "rotation": {
              "$ref": "compute_grasp.candidates.poses.0.rotation"
            },
            "target_obb": {
              "$ref": "in.target_obb"
            }
          },
          "script": "scripts/approach_above.py"
        },
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "build_world": {
          "type": "script",
          "inputs": {
            "observation": {
              "$ref": "observe"
            },
            "target_mask": {
              "$ref": "in.target_mask"
            },
            "target_obb": {
              "$ref": "in.target_obb"
            },
            "target_name": "target"
          },
          "script": "scripts/build_world.py"
        },
        "plan": {
          "type": "script",
          "inputs": {
            "world_config": {
              "$ref": "build_world.config"
            },
            "observation": {
              "$ref": "observe"
            },
            "grasp_poses": {
              "$ref": "compute_grasp.candidates.poses"
            },
            "target_name": "target"
          },
          "script": "scripts/plan_grasp.py"
        },
        "execute": {
          "type": "tool",
          "inputs": {
            "trajectory": {
              "$ref": "plan.trajectory"
            }
          },
          "tool": "robot.execute_trajectory"
        },
        "close": {
          "type": "tool",
          "inputs": {
            "settle_steps": 60
          },
          "tool": "robot.close_gripper"
        },
        "grasped": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "open"
        ],
        [
          "open",
          "compute_grasp"
        ],
        [
          "compute_grasp",
          "approach"
        ],
        [
          "approach",
          "observe"
        ],
        [
          "observe",
          "build_world"
        ],
        [
          "build_world",
          "plan"
        ],
        [
          "plan",
          "execute"
        ],
        [
          "execute",
          "close"
        ],
        [
          "close",
          "grasped"
        ],
        [
          "grasped",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "grasped"
        ]
      },
      "on_error": "failed",
      "stage": "grasp"
    },
    "transport_sg": {
      "skill": "transporting-objects",
      "inputs": {
        "target_obb": "OrientedBoundingBox",
        "target_mask": "Mask",
        "container_obb": "OrientedBoundingBox",
        "container_mask": "Mask",
        "ee_pose_at_grasp": "Se3Pose"
      },
      "outputs": {
        "drop_pose": {
          "$ref": "compute_drop.drop_pose"
        }
      },
      "nodes": {
        "compute_drop": {
          "type": "script",
          "inputs": {
            "container_obb": {
              "$ref": "in.container_obb"
            },
            "held_obb": {
              "$ref": "in.target_obb"
            },
            "ee_pose_at_grasp": {
              "$ref": "in.ee_pose_at_grasp"
            }
          },
          "script": "scripts/compute_drop_pose.py"
        },
        "move_above": {
          "type": "script",
          "inputs": {
            "drop_x": {
              "$ref": "compute_drop.drop_position.x"
            },
            "drop_y": {
              "$ref": "compute_drop.drop_position.y"
            }
          },
          "script": "scripts/waypoint_move.py"
        },
        "release": {
          "type": "script",
          "inputs": {
            "drop_position": {
              "$ref": "compute_drop.drop_position"
            }
          },
          "script": "scripts/descend_release.py"
        },
        "placed": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "compute_drop"
        ],
        [
          "compute_drop",
          "move_above"
        ],
        [
          "move_above",
          "release"
        ],
        [
          "release",
          "placed"
        ],
        [
          "placed",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "placed"
        ]
      },
      "on_error": "blocked",
      "stage": "place"
    }
  }
