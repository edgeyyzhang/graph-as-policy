        },
        "target_mask": {
          "$ref": "perceive.mask"
        },
        "target_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "blue and yellow alphabet soup"
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "container_sg": {
      "skill": "perceiving-objects",
      "inputs": {},
      "outputs": {
        "container_obb": {
          "$ref": "filter_obb.obb"
        },
        "container_mask": {
          "$ref": "perceive.mask"
        },
        "container_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "basket"
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
