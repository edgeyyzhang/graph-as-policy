{
  "version": 3,
  "meta": {
    "name": "task_00",
    "description": "Pick the blue and yellow alphabet soup can and place it in the basket."
  },
  "nodes": {
    "target_sg": {
      "type": "subgraph",
      "ref": "target_sg"
    },
    "container_sg": {
      "type": "subgraph",
      "ref": "container_sg"
    },
    "grasp_sg": {
      "type": "subgraph",
      "ref": "grasp_sg"
    },
    "transport_sg": {
      "type": "subgraph",
      "ref": "transport_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {}
        },
        {
          "tool": "robot.go_home",
          "inputs": {}
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "target_sg"
    ]
  ],
  "conditional_edges": {
    "target_sg": {
      "router_field": "exit",
      "mapping": {
        "found": "container_sg",
        "abort": "abort"
      }
    },
    "container_sg": {
      "router_field": "exit",
      "mapping": {
        "found": "grasp_sg",
        "abort": "abort"
      }
    },
    "grasp_sg": {
      "router_field": "exit",
      "mapping": {
        "grasped": "transport_sg",
        "abort": "abort"
      }
    },
    "transport_sg": {
      "router_field": "exit",
      "mapping": {
        "placed": "done",
        "abort": "abort"
      }
    }
  },
  "subgraphs": {
