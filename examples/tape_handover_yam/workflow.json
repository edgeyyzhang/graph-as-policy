{
  "version": 3,
  "meta": {
    "name": "tape_spool_handover_yam",
    "description": "Routed bimanual tape handover on LIBERO-YAM: probe reachability, hand over only when the destination is out of the picking arm's reach, verify each stage, recover by re-perceiving."
  },
  "nodes": {
    "gripper_geometry": {
      "type": "subgraph",
      "ref": "gripper_geometry"
    },
    "station_geometry": {
      "type": "subgraph",
      "ref": "station_geometry"
    },
    "perceive_dest": {
      "type": "subgraph",
      "ref": "perceive_dest"
    },
