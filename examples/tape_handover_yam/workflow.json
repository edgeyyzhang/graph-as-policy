      "ref": "place"
    },
    "verify_place": {
      "type": "subgraph",
      "ref": "verify_place"
    },
    "dispatch": {
      "type": "router",
      "inputs": {
        "route": {
          "$ref": "route.route"
        }
      },
      "script": "scripts/dispatch_route.py"
    },
    "next_item": {
      "type": "router",
      "inputs": {
        "total_items": 1
      },
      "script": "scripts/next_item.py"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {
            "arm_id": 0
          }
        },
        {
          "tool": "robot.open_gripper",
          "inputs": {
            "arm_id": 1
          }
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "gripper_geometry"
    ]
  ],
  "conditional_edges": {
    "gripper_geometry": {
      "router_field": "exit",
      "mapping": {
        "derived": "station_geometry",
        "failed": "abort"
      }
    },
    "station_geometry": {
      "router_field": "exit",
      "mapping": {
        "derived": "perceive_dest",
        "failed": "abort"
      }
    },
    "perceive_dest": {
      "router_field": "exit",
      "mapping": {
        "perceived": "perceive_target",
        "not_found": "abort"
      }
    },
    "perceive_target": {
      "router_field": "exit",
      "mapping": {
        "perceived": "ring_geometry",
        "not_found": "abort"
      }
    },
    "ring_geometry": {
      "router_field": "exit",
      "mapping": {
        "derived": "route",
        "degenerate": "abort"
      }
    },
    "route": {
      "router_field": "exit",
      "mapping": {
        "direct": "pickup",
        "needs_handover": "pickup",
        "unreachable": "abort"
      }
    },
    "pickup": {
      "router_field": "exit",
      "mapping": {
        "grasped": "verify_grasp",
        "failed": "abort"
      }
    },
    "verify_grasp": {
      "router_field": "exit",
      "mapping": {
        "holding": "dispatch",
        "retry": "perceive_target",
        "give_up": "abort",
        "failed": "abort"
      }
    },
    "present": {
      "router_field": "exit",
      "mapping": {
        "transported": "handover",
        "failed": "abort"
      }
    },
    "handover": {
      "router_field": "exit",
      "mapping": {
        "handed_over": "place",
        "failed": "abort"
      }
    },
    "place": {
      "router_field": "exit",
      "mapping": {
        "placed": "verify_place",
        "failed": "abort"
      }
    },
    "verify_place": {
      "router_field": "exit",
      "mapping": {
        "placed": "next_item",
        "retry": "perceive_target",
        "give_up": "abort",
        "failed": "abort"
      }
    },
    "dispatch": {
      "router_field": null,
      "mapping": {
        "place": "place",
        "present": "present"
      }
    },
    "next_item": {
      "router_field": null,
      "mapping": {
        "done": "done",
        "next": "perceive_dest"
      }
    }
