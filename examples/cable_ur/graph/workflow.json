{
 "version": 3,
 "meta": {
  "name": "locate_white_tape",
  "description": "Locate a green circular adhesive sticker on a cable and report its 3D position in robot base frame."
 },
 "nodes": {
  "locate_white_tape": {
   "type": "subgraph",
   "ref": "locate_white_tape_sg"
  },
  "done": {
   "type": "end",
   "status": "success"
  },
  "abort": {
   "type": "end",
   "status": "failure"
  }
 },
 "edges": [
  [
   "START",
   "locate_white_tape"
  ]
 ],
 "conditional_edges": {
  "locate_white_tape": {
   "router_field": "exit",
   "mapping": {
    "found": "done",
    "not_found": "abort"
   }
  }
 },
 "subgraphs": {
  "locate_white_tape_sg": {
   "skill": "perceiving-objects",
   "inputs": {},
   "outputs": {
    "obb": {
     "$ref": "filter_obb.obb"
    },
    "cloud": {
     "$ref": "perceive.cloud"
    }
   },
   "nodes": {
    "observe": {
     "type": "tool",
     "tool": "robot.get_observation"
    },
    "perceive": {
     "type": "script",
     "script": "scripts/locate_white_tape/perceive_dino_vlm.py",
     "inputs": {
      "cameras": {
       "$ref": "observe.cameras"
      },
      "object_name": "green circular sticker"
     }
    },
    "filter_obb": {
     "type": "tool",
     "tool": "geometry.filter_and_compute_obb",
     "inputs": {
      "points": {
       "$ref": "perceive.cloud"
      }
     }
    },
    "found": {
     "type": "noop"
    }
   },
   "edges": [
    [
     "START",
     "observe"
    ],
    [
     "observe",
     "perceive"
    ],
    [
     "perceive",
     "filter_obb"
    ],
    [
     "filter_obb",
     "found"
    ],
    [
     "found",
     "END"
    ]
   ],
   "conditional_edges": {},
   "exit": {
    "router_field": null,
    "success_values": [
     "found"
    ]
   },
   "on_error": "not_found"
  }
 }
}