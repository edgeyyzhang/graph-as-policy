{
  "version": 3,
  "meta": {
    "name": "grocery_packing",
    "description": "Pick up every grocery item on the table and place each in the basket, looping until only the basket remains. Reuses grocery_fulfillment's perceive/grasp/transport subgraphs verbatim; the loop head perceives a 'grocery item' (never the basket) and exits 'none' when the table is clear."
  },
  "nodes": {
    "container": {
      "type": "subgraph",
      "ref": "container_sg"
    },
    "perceive_next": {
      "type": "subgraph",
      "ref": "perceive_next_sg"
    },
    "grasp": {
      "type": "subgraph",
      "ref": "grasp_sg"
    },
    "transport": {
      "type": "subgraph",
      "ref": "transport_sg"
    },
    "reperceive_basket": {
      "type": "subgraph",
      "ref": "container_sg"
    },
    "push": {
      "type": "subgraph",
      "ref": "push_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {}
        },
        {
          "tool": "robot.go_home",
          "inputs": {}
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "container"
    ]
  ],
  "conditional_edges": {
    "container": {
      "router_field": "exit",
      "mapping": {
        "found": "perceive_next",
        "not_found": "abort"
      }
    },
    "perceive_next": {
      "router_field": "exit",
      "mapping": {
        "found": "push",
        "none": "done",
        "not_found": "abort"
      }
    },
    "push": {
      "router_field": "exit",
      "mapping": {
        "clear": "grasp",
        "pushed": "container",
        "blocked": "abort"
      }
    },
    "grasp": {
      "router_field": "exit",
      "mapping": {
        "grasped": "reperceive_basket",
        "failed": "abort"
      }
    },
    "reperceive_basket": {
      "router_field": "exit",
      "mapping": {
        "found": "transport",
        "not_found": "abort"
      }
    },
    "transport": {
      "router_field": "exit",
      "mapping": {
        "placed": "perceive_next",
        "blocked": "abort"
      }
    }
  },
  "subgraphs": {
    "container_sg": {
      "skill": "perceiving-objects",
      "inputs": {},
      "outputs": {
        "container_obb": {
          "$ref": "filter_obb.obb"
        },
        "container_mask": {
          "$ref": "perceive.mask"
        },
        "container_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "exterior_view.cameras"
            },
            "object_name": "basket"
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        },
        "exterior_view": {
          "type": "script",
          "script": "scripts/exterior_view.py",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            }
          }
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "exterior_view"
        ],
        [
          "exterior_view",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "grasp_sg": {
      "skill": "grasping-with-planner",
      "inputs": {
        "target_obb": "OrientedBoundingBox"
      },
      "outputs": {
        "ee_pose_at_grasp": {
          "$ref": "observe.arms.0.ee_pose"
        }
      },
      "nodes": {
        "open": {
          "type": "tool",
          "tool": "robot.open_gripper",
          "inputs": {
            "settle_steps": 40
          }
        },
        "compute_grasp": {
          "type": "tool",
          "tool": "geometry.top_down_grasp_candidates",
          "inputs": {
            "obb": {
              "$ref": "in.target_obb"
            },
            "z_offset": -0.03
          }
        },
        "select_short_axis": {
          "type": "script",
          "script": "scripts/select_short_axis.py",
          "inputs": {
            "target_obb": {
              "$ref": "in.target_obb"
            },
            "candidate_poses": {
              "$ref": "compute_grasp.candidates.poses"
            },
            "prefer": "short"
          }
        },
        "goto_grasp": {
          "type": "script",
          "script": "scripts/grasp_move.py",
          "inputs": {
            "grasp_pose": {
              "$ref": "select_short_axis.poses.0"
            },
            "candidate_poses": {
              "$ref": "select_short_axis.poses"
            },
            "target_obb": {
              "$ref": "in.target_obb"
            },
            "hover_z": 0.2
          }
        },
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "close": {
          "type": "tool",
          "tool": "robot.close_gripper",
          "inputs": {
            "settle_steps": 60
          }
        },
        "grasped": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "open"
        ],
        [
          "open",
          "compute_grasp"
        ],
        [
          "compute_grasp",
          "select_short_axis"
        ],
        [
          "select_short_axis",
          "goto_grasp"
        ],
        [
          "goto_grasp",
          "observe"
        ],
        [
          "observe",
          "close"
        ],
        [
          "close",
          "grasped"
        ],
        [
          "grasped",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "grasped"
        ]
      },
      "on_error": "failed",
      "stage": "grasp"
    },
    "transport_sg": {
      "skill": "transporting-objects",
      "inputs": {
        "container_obb": "OrientedBoundingBox"
      },
      "outputs": {
        "place_position": {
          "$ref": "transport_move.place_position"
        }
      },
      "nodes": {
        "transport_move": {
          "type": "script",
          "script": "scripts/transport_move.py",
          "inputs": {
            "container_obb": {
              "$ref": "in.container_obb"
            },
            "place_offset": -0.06
          }
        },
        "release": {
          "type": "script",
          "script": "scripts/place_release.py",
          "inputs": {
            "place_position": {
              "$ref": "transport_move.place_position"
            }
          }
        },
        "placed": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "transport_move"
        ],
        [
          "transport_move",
          "release"
        ],
        [
          "release",
          "placed"
        ],
        [
          "placed",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "placed"
        ]
      },
      "on_error": "blocked",
      "stage": "place"
    },
    "perceive_next_sg": {
      "skill": "perceiving-objects",
      "inputs": {
        "container_obb": "OrientedBoundingBox"
      },
      "outputs": {
        "target_obb": {
          "$ref": "filter_obb.obb"
        },
        "target_mask": {
          "$ref": "perceive.mask"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "grocery item",
            "object_description": "a packaged grocery product such as a can, box, carton, jar, or bottle. Never the wicker basket or storage container that the items are being packed into."
          },
          "script": "scripts/perceive_dino_vlm.py"
        },
        "decide": {
          "type": "router",
          "inputs": {
            "found": {
              "$ref": "perceive.found"
            },
            "cloud": {
              "$ref": "perceive.cloud"
            },
            "container_obb": {
              "$ref": "in.container_obb"
            }
          },
          "script": "scripts/route_next_object.py"
        },
        "filter_obb": {
          "type": "tool",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          },
          "tool": "geometry.filter_and_compute_obb"
        },
        "found": {
          "type": "noop"
        },
        "none": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "decide"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ],
        [
          "none",
          "END"
        ]
      ],
      "conditional_edges": {
        "decide": {
          "router_field": null,
          "mapping": {
            "found": "filter_obb",
            "none": "none"
          }
        }
      },
      "exit": {
        "router_field": null,
        "success_values": [
          "found",
          "none"
        ]
      },
      "on_error": "not_found"
    },
    "push_sg": {
      "skill": "",
      "inputs": {
        "target_obb": "OrientedBoundingBox",
        "container_obb": "OrientedBoundingBox"
      },
      "outputs": {},
      "nodes": {
        "decide_push": {
          "type": "router",
          "inputs": {
            "target_obb": {
              "$ref": "in.target_obb"
            },
            "container_obb": {
              "$ref": "in.container_obb"
            }
          },
          "script": "scripts/push_basket_away.py"
        },
        "clear": {
          "type": "noop"
        },
        "pushed": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "decide_push"
        ],
        [
          "clear",
          "END"
        ],
        [
          "pushed",
          "END"
        ]
      ],
      "conditional_edges": {
        "decide_push": {
          "router_field": null,
          "mapping": {
            "clear": "clear",
            "pushed": "pushed"
          }
        }
      },
      "exit": {
        "router_field": null,
        "success_values": [
          "clear",
          "pushed"
        ]
      },
      "on_error": "blocked"
    }
  }
}
