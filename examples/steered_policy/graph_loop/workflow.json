{
  "version": 3,
  "meta": {
    "name": "graph_obb_policy_loop",
    "description": "Long-horizon clean-all-items loop that steers a VLA policy. capture records the arm's joint configuration at episode start (the policy's initial pose). Each iteration: reset moves the arm back to that captured initial pose so every pick starts in-distribution for the VLA (instead of starting from wherever the previous place left the arm), perception_any localizes the next item on the floor, a Cartesian approach pre-positions the end-effector above its OBB, then the {{policy_id}} closed-loop VLA picks it and places it in the basket; that stage ends when the policy's commanded gripper completes one open->close->open grasp/release cycle. run loops back to reset; the loop ends with success once perception_any reports not_found (all items delivered & teleported off-camera). Materialized per benchmark cell via the {{policy_id}} placeholder."
  },
  "nodes": {
    "capture": {
      "type": "subgraph",
      "ref": "capture_sg"
    },
    "reset": {
      "type": "subgraph",
      "ref": "reset_sg"
    },
    "target": {
      "type": "subgraph",
      "ref": "target_sg"
    },
    "approach": {
      "type": "subgraph",
      "ref": "approach_sg"
    },
    "run": {
      "type": "subgraph",
      "ref": "run_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {
            "settle_steps": 40
          }
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "capture"
    ]
  ],
  "conditional_edges": {
    "capture": {
      "router_field": "exit",
      "mapping": {
        "done": "target",
        "failed": "abort"
      }
    },
    "target": {
      "router_field": "exit",
      "mapping": {
        "found": "approach",
        "not_found": "done"
      }
    },
    "approach": {
      "router_field": "exit",
      "mapping": {
        "ready": "run",
        "failed": "abort"
      }
    },
    "run": {
      "router_field": "exit",
      "mapping": {
        "succeeded": "reset",
        "failed": "abort"
      }
    },
    "reset": {
      "router_field": "exit",
      "mapping": {
        "done": "target",
        "failed": "abort"
      }
    }
  },
  "subgraphs": {
    "capture_sg": {
      "skill": "generic",
      "inputs": {},
      "outputs": {
        "initial_joints": {
          "$ref": "observe.arm_states.0.joint_state"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "done": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "done"
        ],
        [
          "done",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "done"
        ]
      },
      "on_error": "failed"
    },
    "reset_sg": {
      "skill": "generic",
      "inputs": {
        "initial_joints": "JointState"
      },
      "outputs": {},
      "nodes": {
        "open_gripper": {
          "type": "tool",
          "tool": "robot.open_gripper",
          "inputs": {
            "settle_steps": 20
          }
        },
        "move_to_initial": {
          "type": "tool",
          "tool": "robot.move_to_joints",
          "inputs": {
            "joint_config": {
              "$ref": "in.initial_joints"
            },
            "tolerance": 0.005,
            "max_steps": 800
          }
        },
        "done": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "open_gripper"
        ],
        [
          "open_gripper",
          "move_to_initial"
        ],
        [
          "move_to_initial",
          "done"
        ],
        [
          "done",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "done"
        ]
      },
      "on_error": "failed"
    },
    "target_sg": {
      "skill": "perceiving-objects-oneshot",
      "inputs": {},
      "outputs": {
        "target_obb": {
          "$ref": "filter_obb.obb"
        },
        "target_mask": {
          "$ref": "perceive.mask"
        },
        "target_cloud": {
          "$ref": "perceive.cloud"
        }
      },
      "nodes": {
        "observe": {
          "type": "tool",
          "tool": "robot.get_observation"
        },
        "perceive": {
          "type": "script",
          "script": "scripts/target/perceive_simple.py",
          "inputs": {
            "cameras": {
              "$ref": "observe.cameras"
            },
            "object_name": "item on the floor"
          }
        },
        "filter_obb": {
          "type": "tool",
          "tool": "geometry.filter_and_compute_obb",
          "inputs": {
            "points": {
              "$ref": "perceive.cloud"
            }
          }
        },
        "found": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "observe"
        ],
        [
          "observe",
          "perceive"
        ],
        [
          "perceive",
          "filter_obb"
        ],
        [
          "filter_obb",
          "found"
        ],
        [
          "found",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "found"
        ]
      },
      "on_error": "not_found"
    },
    "approach_sg": {
      "skill": "generic",
      "inputs": {
        "target_obb": "OrientedBoundingBox"
      },
      "outputs": {},
      "nodes": {
        "approach_above": {
          "type": "script",
          "script": "scripts/approach/approach_above_target.py",
          "inputs": {
            "target_obb": {
              "$ref": "in.target_obb"
            },
            "target_z": 0.3,
            "obb_clearance": 0.12,
            "move_tolerance": 0.003,
            "move_max_steps": 400
          }
        },
        "ready": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "approach_above"
        ],
        [
          "approach_above",
          "ready"
        ],
        [
          "ready",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "ready"
        ]
      },
      "on_error": "failed"
    },
    "run_sg": {
      "skill": "generic",
      "inputs": {
        "observation_stream": "ObservationStream"
      },
      "outputs": {},
      "nodes": {
        "run_policy": {
          "type": "tool",
          "tool": "{{policy_id}}.run",
          "inputs": {
            "observation_stream": {
              "$ref": "in.observation_stream"
            },
            "prompt": "pick up the object and place it in the basket",
            "termination_prompt": "",
            "gripper_cycle_termination": true,
            "max_windows": 70,
            "replan_every": 5,
            "term_period": 6,
            "arm_id": 0,
            "vlm_camera": 0,
            "settle_steps": 10
          }
        },
        "succeeded": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "run_policy"
        ],
        [
          "run_policy",
          "succeeded"
        ],
        [
          "succeeded",
          "END"
        ]
      ],
      "conditional_edges": {},
      "exit": {
        "router_field": null,
        "success_values": [
          "succeeded"
        ]
      },
      "on_error": "failed"
    }
  }
}